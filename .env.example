# --- X / Twitter (Scweet) ---
# Default backend: Scweet (https://github.com/Altimis/Scweet).
# Bir X hesabına login olduktan sonra DevTools > Application > Cookies altında
# `auth_token` değerini kopyala. Throwaway hesap önerilir (ban riski).
X_AUTH_TOKEN=

# Resmi API kullanılacaksa doldur (Bearer Token, v2) — opsiyonel.
X_BEARER_TOKEN=

# --- LLM (Google Gemini, ücretsiz tier) ---
# https://aistudio.google.com → Get API key. Kart kaydı gerekmiyor.
# 1500 req/gün, 15 req/dk free tier limiti.
GEMINI_API_KEY=

# --- Exchange (sadece public market data icin yeterli, key opsiyonel) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Runtime ---
LOG_LEVEL=INFO
DATA_DIR=./data
