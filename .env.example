# --- X / Twitter ---
# Default: ücretsiz Nitter RSS scrape.
# Virgülle ayrılmış instance listesi; ilki başarısız olursa sıradakine geçilir.
# Çalışan public instance listesi sık değişiyor, kontrol et:
#   https://github.com/zedeus/nitter/wiki/Instances
NITTER_INSTANCES=https://nitter.net,https://nitter.privacydev.net

# Resmi API kullanılacaksa doldur (Bearer Token, v2 endpoints) — opsiyonel.
X_BEARER_TOKEN=

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Exchange (sadece public market data icin yeterli, key opsiyonel) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Runtime ---
LOG_LEVEL=INFO
DATA_DIR=./data
